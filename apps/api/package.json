{
  "name": "@app/api",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Hono API on Bun with Drizzle SQLite storage and optional ECIES at-rest encryption.",
  "homepage": "https://github.com/bkhq/lode-server",
  "repository": {
    "type": "git",
    "url": "https://github.com/bkhq/lode-server.git",
    "directory": "apps/api"
  },
  "exports": {
    ".": "./src/dev.ts"
  },
  "scripts": {
    "dev": "nsl run --name \"${APP_NAME:-app}:${BASE_PATH:-}/api\" bun --env-file=../../.env --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --minify",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=/dev/null test",
    "test:coverage": "bun --env-file=/dev/null test --coverage",
    "db:generate": "drizzle-kit generate && bun scripts/gen-do-migrations.ts",
    "db:check-migrations": "bun scripts/gen-do-migrations.ts --check",
    "workers:dev": "wrangler dev",
    "workers:build": "wrangler deploy --dry-run --outdir dist-workers",
    "workers:deploy": "wrangler deploy",
    "db:studio": "drizzle-kit studio",
    "gen:api-docs": "bun scripts/gen-api-docs.ts",
    "check:api-docs": "bun scripts/gen-api-docs.ts --check"
  },
  "dependencies": {
    "@app/shared": "workspace:*",
    "@hono/standard-validator": "0.4.0",
    "@libsql/client": "0.18.0",
    "@scalar/hono-api-reference": "0.12.11",
    "cac": "7.0.1",
    "consola": "3.4.2",
    "cronbake": "0.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "hono-openapi": "1.3.5",
    "nanoid": "6.0.2",
    "oauth4webapi": "3.8.8",
    "otpauth": "9.5.2",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@app/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/bun": "1.4.2",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.11",
    "typescript": "catalog:",
    "wrangler": "4.149.0"
  }
}
